coverage/

# Raw sensor recordings (large, generated)
/data/raw/*.jsonl
/data/raw/manifest.json

# Processed datasets (regeneratable)
/data/processed/*.npz
/data/processed/*.json

# Trained models (regeneratable)
/models/*.pkl
/models/*.json

# Evaluation results (regeneratable)
/results/*.json
/results/figures/*.png

# Keep gitkeep files
!**/.gitkeep

/.freebuff
